# apps/api — placeholder values only (G1); real values come from the environment.
# Matches docker-compose.yml's db service credentials (swab/swab_local_dev) so
# `pnpm --filter @repo/api dev` on the host against the compose Postgres works
# out of the box.
DATABASE_URL=postgresql://swab:swab_local_dev@localhost:5432/swab
JWT_SECRET=replace-with-a-random-string-of-32-chars-or-more
PORT=3001
NODE_ENV=development
# Echoes the OTP code in /auth/otp/request responses (POC — no SMS provider yet).
# Fail-closed: must never be "enabled" in production — boot refuses it (G1).
OTP_DEV_CODE=enabled
# Number of trusted reverse-proxy hops in front of the API (0 = directly exposed,
# X-Forwarded-For ignored). Set to 1 behind a single load balancer/ALB so per-IP
# rate limiting (IDT-03) keys on the real client, not the proxy.
TRUST_PROXY_HOPS=0
# Per-IP OTP rate limit tier (issue #128). "strict" = 10/min (IDT-03, the only
# value allowed in production — boot refuses "relaxed" there, see env.ts).
# "relaxed" = 100 per 20 minutes, for local dev / on-device / E2E runs where
# scripted requests from one IP otherwise trip the strict tier constantly.
OTP_RATE_LIMIT=relaxed
