# Placeholder values only (G1) — real values come from the environment, never committed.
# Matches docker-compose.yml's db service credentials (swab/swab_local_dev).
DATABASE_URL=postgresql://swab:swab_local_dev@localhost:5432/swab

# SUG-DB-010: prisma/seed.ts wipes every table before seeding. It refuses to run
# unless DATABASE_URL points at localhost/127.0.0.1/the compose "db" host, or
# this is set to "1" — preview/CI branches (Neon) opt in explicitly.
#SEED_ALLOW_WIPE=1
