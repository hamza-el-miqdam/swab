// Swab schema v0.1 — copied from swab-domain-spec.md §4, single writer: Data & Schema Steward.
// Naming: camelCase fields / PascalCase models in Prisma, explicit @map/@@map to snake_case in Postgres.
// Vanilla Postgres only (no Neon-specific extensions) — AWS portability is a hard requirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  phoneHash        String           @unique @map("phone_hash") // E.164 hashed client-side — contact discovery without storing raw numbers (G1: no plaintext phone/email columns, ever)
  displayName      String           @map("display_name")
  createdAt        DateTime         @default(now()) @map("created_at")
  vault            Vault?
  devices          Device[]
  linksOut         ContactLink[]    @relation("owner")
  linksIn          ContactLink[]    @relation("target")
  envies           Envie[]
  matchesA         Match[]          @relation("userA")
  matchesB         Match[]          @relation("userB")
  proposals        Proposal[]
  envieRecipientOf EnvieRecipient[] @relation("envieRecipient")
  clientMutations  ClientMutation[]

  @@map("users")
}

/// DEPRECATED (ADR-001, 2026-08-16) — superseded by the typed classification
/// columns on ContactLink/ContactRole below. Kept, NOT dropped: `apps/api`
/// still serves GET/POST /vault and both clients still call it. Dropping the
/// model here would break the API build and both apps in the same commit.
/// It is removed at ADR-001 stage 3/4, once the typed endpoints ship and the
/// clients cut over — that PR also carries the one-off data migration.
/// Until then: no new writers, no new columns, no reads from new code.
model Vault {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blob      Bytes
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vaults")
}

model Device {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken String?  @map("push_token")
  platform  Platform
  createdAt DateTime @default(now()) @map("created_at")

  // Query pattern: push-notification fanout (IDT-05) + deletion cascade scan.
  @@index([userId])
  @@map("devices")
}

/// The directional edge AND the owner's classification of the target
/// (ADR-001: "Edge only — classification lives in the owner's Vault" is
/// retired). Merged into one row rather than a 1:1 side table because every
/// read of an axis is a read of the edge — the map, the fiche and scope
/// resolution all want them together, and a join buys nothing.
///
/// **Directionality is the privacy model (IDT-08), not a modelling detail.**
/// A row says how `owner` sees `target`. There is no reverse read: `target`
/// must never be able to reach this row through any endpoint, and no query in
/// this codebase may select classification columns filtered by `target_id`
/// alone. B never learns they are in A's circle.
///
/// Sync (VLT-07..10): `updatedAt` drives cursor pulls, `deletedAt` tombstones
/// deletes, and the four `*UpdatedAt` columns carry field-level LWW.
///
/// Why per-field timestamps, when a plain PATCH already only touches one
/// column: the offline outbox (VLT-10) replays *stale* mutations. Device B
/// comes back online and replays "set ressenti" from two hours ago; device A
/// set it five minutes ago. Arrival order would let the stale write win, and
/// client clocks are untrustworthy by VLT-08 — so a write carries the field
/// timestamp it last saw and the server rejects it if the column moved on.
/// Record-level `updatedAt` alone cannot express that (FS-03: ring on A and
/// ressenti on B must BOTH survive).
model ContactLink {
  id               String   @id @default(cuid())
  ownerId          String   @map("owner_id")
  owner            User     @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId         String?  @map("target_id") // null until the invited person joins
  target           User?    @relation("target", fields: [targetId], references: [id], onDelete: SetNull)
  invitedPhoneHash String?  @map("invited_phone_hash") // discovery handle while target is null
  createdAt        DateTime @default(now()) @map("created_at")

  // --- Classification (ADR-001). Never logged, never exposed to another user (VLT-03, IDT-08).
  /// The owner's own label for this person — their address-book name, not the
  /// target's chosen `User.displayName`. Nullable because a link can be created
  /// by discovery before the owner names it; the API requires it on owner-created
  /// contacts and clients fall back to `target.displayName` when it is null.
  displayName      String?  @map("display_name") @db.VarChar(50)
  /// Intimité, 1 = innermost (ONB-04). Range enforced by a CHECK constraint in
  /// the migration — Prisma cannot express it, and an out-of-range value breaks
  /// the clients' ring layout maths rather than failing loudly.
  ring             Int?
  etat             Etat?
  ressenti         Ressenti?
  roles            ContactRole[]

  // --- FCH-05 staleness nudge. Server-side now, so the 30-day timer survives a device change.
  lastAxisChangeAt      DateTime? @map("last_axis_change_at") @db.Timestamptz(3)
  stalenessSnoozedUntil DateTime? @map("staleness_snoozed_until") @db.Timestamptz(3)

  // --- Sync (VLT-07..10)
  displayNameUpdatedAt DateTime? @map("display_name_updated_at") @db.Timestamptz(3)
  ringUpdatedAt        DateTime? @map("ring_updated_at") @db.Timestamptz(3)
  etatUpdatedAt        DateTime? @map("etat_updated_at") @db.Timestamptz(3)
  ressentiUpdatedAt    DateTime? @map("ressenti_updated_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Tombstone, not a hard delete (VLT-09): a stale device replaying a
  /// pre-deletion update must not resurrect the contact.
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  // One LIVE edge per (owner, target). Enforced as a PARTIAL unique index
  // (`WHERE deleted_at IS NULL`) in the migration, not here: Prisma cannot
  // express partial uniques, and a plain unique would make "delete a contact,
  // then re-add the same person" fail forever against the tombstone.
  // Query pattern: resolve pending invites when a new user registers (IDT-07).
  @@index([invitedPhoneHash])
  // Query pattern: cursor delta pull — "everything of mine that changed since X" (VLT-08).
  @@index([ownerId, updatedAt])
  // Query pattern: SetNull scan on user deletion; "who links to me" resolution (IDT-07).
  @@index([targetId])
  @@map("contact_links")
}

/// Rôles·contexte is multi-select, so each tag is its own row — which also
/// makes it field-level-LWW-able for free (VLT-09): two devices adding
/// different roles both win, with no merge logic.
model ContactRole {
  contactLinkId String       @map("contact_link_id")
  contactLink   ContactLink  @relation(fields: [contactLinkId], references: [id], onDelete: Cascade)
  role          RoleContexte
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Tombstoned like its parent — removing a role is a sync event, not a gap.
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(3)

  @@id([contactLinkId, role])
  // Query pattern: cursor delta pull of a contact's tags (VLT-08).
  @@index([contactLinkId, updatedAt])
  @@map("contact_roles")
}

/// VLT-07 idempotency ledger. Every client mutation carries a client-generated
/// id; replaying it after a timeout or a half-failed request must not
/// double-apply. The server records the id inside the same transaction as the
/// write, so "applied" and "recorded" cannot disagree.
///
/// Scoped by user on purpose: a globally-unique id would let one account's
/// chosen id collide with — or probe for — another's.
///
/// Deliberately does NOT cache the response body. A replay is answered "already
/// applied" and the client re-pulls by cursor, which it does anyway. Storing
/// responses would mean storing classification data twice, in a table nobody
/// audits (VLT-03).
model ClientMutation {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String   @db.VarChar(64)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(3)

  @@id([userId, id])
  // Query pattern: retention sweep — this table grows forever otherwise.
  @@index([appliedAt])
  @@map("client_mutations")
}

model Envie {
  id         String           @id @default(cuid())
  authorId   String           @map("author_id")
  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  verb       String // « envie de… », present tense, as spoken — user content: never logged, never full-text-indexed
  category   String // client-suggested normalized category — matching key
  status     EnvieStatus      @default(ACTIVE)
  expiresAt  DateTime         @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  recipients EnvieRecipient[]
  matchesA   Match[]          @relation("envieA")
  matchesB   Match[]          @relation("envieB")

  // Query pattern: reciprocal-candidate lookup on envie creation (hot path) + expiry sweep.
  @@index([category, status, expiresAt])
  // Query pattern: "my active envies" listing with withdraw (ENV-06) + deletion cascade.
  @@index([authorId, status])
  @@map("envies")
}

/// Final resolved list only — scope names and filter reasons never reach the server.
model EnvieRecipient {
  envieId     String   @map("envie_id")
  envie       Envie    @relation(fields: [envieId], references: [id], onDelete: Cascade)
  recipientId String   @map("recipient_id")
  recipient   User     @relation("envieRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([envieId, recipientId])
  // Query pattern: "which active envies am I a recipient of?" during match computation.
  @@index([recipientId])
  @@map("envie_recipients")
}

model Match {
  id         String     @id @default(cuid())
  envieAId   String     @map("envie_a_id")
  envieA     Envie      @relation("envieA", fields: [envieAId], references: [id], onDelete: Cascade)
  envieBId   String     @map("envie_b_id")
  envieB     Envie      @relation("envieB", fields: [envieBId], references: [id], onDelete: Cascade)
  userAId    String     @map("user_a_id")
  userA      User       @relation("userA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId    String     @map("user_b_id")
  userB      User       @relation("userB", fields: [userBId], references: [id], onDelete: Cascade)
  state      MatchState @default(OPEN)
  notifiedAt DateTime?  @map("notified_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  proposals  Proposal[]

  // Reciprocity-race arbiter (DAT rule 5): concurrent envie creation may both detect
  // the pair — this constraint guarantees a single match row.
  //
  // INVARIANT (SUG-DB-003, ENV-09): envieAId is always the lexicographically
  // smaller of the pair, userAId/userBId are correspondingly the authors of
  // envieA/envieB. Backend sorts the pair before insert. Enforced by a CHECK
  // Prisma cannot express here — see migration `match_pair_canonical_order`.
  @@unique([envieAId, envieBId])
  // Query pattern: GET /matches is WHERE user_a_id = ? OR user_b_id = ? — both sides need
  // their own index; the pair-unique above only leads with envieAId.
  @@index([userAId])
  @@index([userBId])
  // Query pattern: envie deletion cascades via the envieB relation too.
  @@index([envieBId])
  @@map("matches")
}

model Proposal {
  id         String        @id @default(cuid())
  matchId    String        @map("match_id")
  match      Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  proposerId String        @map("proposer_id")
  proposer   User          @relation(fields: [proposerId], references: [id], onDelete: Cascade)
  place      String?
  timeslot   DateTime?
  state      ProposalState @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")

  // Query pattern: proposals-for-match reads (ENV-14) + both deletion cascades.
  @@index([matchId])
  @@index([proposerId])
  @@map("proposals")
}

/// FCH-09 / FS-03 § "Stored value vocabulary" — the NORMATIVE source for these
/// three vocabularies is the spec table, not this file and not either client.
/// Prisma names are SCREAMING_CASE by convention; every value @maps to the
/// exact identifier the clients persist, so a stored byte is the same string on
/// device and in Postgres.
///
/// Adding or renaming a value is a spec amendment first, then a migration here.
/// A closed enum is deliberate: the clients tolerate unknown tokens (they must,
/// for legacy blobs), but the server validates — an unmappable value is a 400,
/// never a silently stored mystery string.
enum Etat {
  AVAILABLE @map("available")
  BUSY      @map("busy")
  AWAY      @map("away")
  PAUSED    @map("paused")

  @@map("etat")
}

enum Ressenti {
  POSITIVE   @map("positive")
  AMBIVALENT @map("ambivalent")
  NEGATIVE   @map("negative")

  @@map("ressenti")
}

enum RoleContexte {
  FAMILY    @map("family")
  PARTNER   @map("partner")
  COLLEAGUE @map("colleague")
  COHORT    @map("cohort")
  COMMUNITY @map("community")
  NEIGHBOR  @map("neighbor")

  @@map("role_contexte")
}

enum Platform {
  IOS
  ANDROID
  WEB

  @@map("platform")
}

enum EnvieStatus {
  ACTIVE
  EXPIRED
  WITHDRAWN

  @@map("envie_status")
}

// PASSED is private to the passer — the counterpart's reads are bit-identical either way.
enum MatchState {
  OPEN
  PROPOSED
  SCHEDULED
  PASSED
  EXPIRED

  @@map("match_state")
}

enum ProposalState {
  PENDING
  ACCEPTED
  DECLINED
  LAPSED

  @@map("proposal_state")
}
